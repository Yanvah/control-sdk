{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "libReplacement": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowJs": false,
    "skipLibCheck": false,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
